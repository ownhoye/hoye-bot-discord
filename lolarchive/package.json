{
    "name": "lolarchive",
    "private": true,
    "version": "1.0.0",
    "description": "LolArchive - archiveur chiffre perso (.lol / .xxx)",
    "main": "dist/main.js",
    "license": "GPL-3.0-or-later",
    "author": "LoliCord",
    "scripts": {
        "build": "node build.mjs",
        "start": "node build.mjs && electron .",
        "test": "node build.mjs && node --test test/*.test.mjs",
