        "dist": "node build.mjs && electron-builder --config electron-builder.config.cjs"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "electron": "^41.0.3",
        "electron-builder": "^26.8.1",
        "esbuild": "^0.27.0",
        "typescript": "^5.9.3"
    }
}
