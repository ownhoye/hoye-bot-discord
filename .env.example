# ───── Bot ─────
DISCORD_TOKEN=ton_token_ici
CLIENT_ID=id_de_l_application

# ───── Rangs (IDs Discord séparés par des virgules) ─────
# Développeurs : accès total + commandes /dev
DEV_IDS=123456789012345678
# Owners principaux du bot : accès total à la config sur tous les serveurs,
# peuvent ajouter/retirer d'autres owners avec /owner
OWNER_IDS=123456789012345678,234567890123456789

# ───── Optionnel ─────
# Serveur de dev : les commandes /dev, /owner et /blacklist n'y sont enregistrées que là
DEV_GUILD_ID=
# Couleur principale des panneaux (hex)
MAIN_COLOR=#5865F2
# Lien du serveur support (affiché dans /help et /botinfo)
SUPPORT_URL=
